{
  "manifest_version": 3,
  "name": "LDS Directory Flashcards",
  "description": "A simple way to learn the names of members in your ward.",
  "action": { "default_title": "Activate LDS Directory Flashcards" },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "css": ["styles.css"],
      "matches": ["https://directory.churchofjesuschrist.org/*"]
    }
  ]
}
